+#!/usr/bin/env python3
+import os
+import sys
+import json
+import signal
+import sqlite3
+import subprocess
+import time
+import ast
+import hashlib
+from datetime import datetime
+
+KESSEL_DIR = os.path.expanduser("~/.kessel")
+PID_FILE = os.path.join(KESSEL_DIR, "pids.json")
+DB_PATH = os.path.join(KESSEL_DIR, "agent_queue.db")
+DAEMON_PATH = os.path.join(KESSEL_DIR, "sentinel_daemon.py")
+
+def init_env():
+    os.makedirs(KESSEL_DIR, exist_ok=True)
+    with sqlite3.connect(DB_PATH) as conn:
+        # ⚡ Bolt Optimization: Enable WAL, MEMORY temp_store, and NORMAL sync
+        # to drastically reduce disk I/O latency for rapid state transitions in the queue.
+        conn.execute("PRAGMA journal_mode = WAL;")
+        conn.execute("PRAGMA synchronous = NORMAL;")
+        conn.execute("PRAGMA temp_store = MEMORY;")
+        conn.execute("PRAGMA busy_timeout = 5000;")
+        conn.execute("""
+        CREATE TABLE IF NOT EXISTS queue (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
+            sender TEXT NOT NULL,
+            recipient TEXT NOT NULL,
+            action TEXT NOT NULL,
+            payload TEXT NOT NULL,
+            retries INTEGER DEFAULT 0,
+            status TEXT NOT NULL DEFAULT 'PENDING'
+        );
+        """)
+
+        # ⚡ Bolt Optimization: Add index to rapidly filter queue items by recipient and status,
+        # converting O(N) full table scans into O(log N) index lookups during daemon polling.
+        conn.execute("CREATE INDEX IF NOT EXISTS idx_queue_recipient_status ON queue(recipient, status);")
+
+        try:
+            conn.execute("ALTER TABLE queue ADD COLUMN retries INTEGER DEFAULT 0;")
+        except sqlite3.OperationalError:
+            pass
+
+    # Ensure daemon script is present in ~/.kessel
+    if not os.path.exists(DAEMON_PATH):
+        with open(DAEMON_PATH, "w") as f:
+            f.write('''import time, os, ast, sqlite3, json, hashlib
+from datetime import datetime
+
+DB_PATH = os.path.expanduser("~/.kessel/agent_queue.db")
+
+class SecurityASTVisitor(ast.NodeVisitor):
+    def __init__(self):
+        self.issues = []
+    def visit_Assign(self, node):
+        sensitive = {"api_key", "secret", "token", "password"}
+        for target in node.targets:
+            if isinstance(target, ast.Name) and target.id.lower() in sensitive:
+                if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
+                    self.issues.append(f"Hardcoded credential in '{target.id}'. Move to os.getenv().")
+        self.generic_visit(node)
+
+conn = sqlite3.connect(DB_PATH, timeout=10.0)
+while True:
+    with conn:
+        cur = conn.cursor()
+        cur.execute("SELECT id, sender, payload, retries FROM queue WHERE recipient = 'Sentinel' AND status = 'PENDING' ORDER BY id ASC LIMIT 1")
+        row = cur.fetchone()
+        if row:
+            msg_id, sender, raw_payload, retries = row
+            cur.execute("UPDATE queue SET status = 'PROCESSING' WHERE id = ?", (msg_id,))
+            payload = json.loads(raw_payload)
+            artifact = payload.get("artifact_path")
+
+            with open(artifact, "r") as af:
+                tree = ast.parse(af.read())
+            v = SecurityASTVisitor()
+            v.visit(tree)
+
+            cur.execute("UPDATE queue SET status = 'COMPLETED' WHERE id = ?", (msg_id,))
+            if v.issues:
+                cur.execute("INSERT INTO queue (sender, recipient, action, payload, retries, status) VALUES ('Sentinel', 'Builder', 'remediate', ?, ?, 'PENDING')",
+                            (json.dumps({"issues": v.issues, "artifact_path": artifact}), retries + 1))
+            else:
+                with open(artifact, "rb") as af:
+                    sha = hashlib.sha256(af.read()).hexdigest()
+                manifest = {"timestamp": datetime.utcnow().isoformat() + "Z", "artifact": os.path.basename(artifact), "sha256": sha, "status": "PASSED"}
+                with open(artifact + ".manifest.json", "w") as mf:
+                    json.dump(manifest, mf, indent=2)
+                cur.execute("INSERT INTO queue (sender, recipient, action, payload, retries, status) VALUES ('Sentinel', 'Client', 'workflow_complete', ?, 0, 'PENDING')",
+                            (json.dumps({"status": "PASSED", "artifact_path": artifact}),))
+    time.sleep(0.5)
+''')
+
+def get_pids():
+    if os.path.exists(PID_FILE):
+        try:
+            with open(PID_FILE, "r") as f:
+                return json.load(f)
+        except Exception:
+            return {}
+    return {}
+
+def is_running(pid):
+    if not pid: return False
+    try:
+        os.kill(pid, 0)
+        return True
+    except OSError:
+        return False
+
+def cmd_start():
+    init_env()
+    pids = get_pids()
+    sentinel_pid = pids.get("sentinel")
+    if is_running(sentinel_pid):
+        print(f"[Kessel] Sentinel daemon is already running (PID {sentinel_pid}).")
+        return
+
+    proc = subprocess.Popen([sys.executable, DAEMON_PATH], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    pids["sentinel"] = proc.pid
+    with open(PID_FILE, "w") as f:
+        json.dump(pids, f, indent=2)
+    print(f"[Kessel] Started Sentinel daemon (PID {proc.pid}).")
+
+def cmd_stop():
+    pids = get_pids()
+    sentinel_pid = pids.get("sentinel")
+    if is_running(sentinel_pid):
+        os.kill(sentinel_pid, signal.SIGTERM)
+        print(f"[Kessel] Stopped Sentinel daemon (PID {sentinel_pid}).")
+    else:
+        print("[Kessel] Sentinel daemon is not running.")
+    if os.path.exists(PID_FILE):
+        os.remove(PID_FILE)
+
+def cmd_status():
+    init_env()
+    pids = get_pids()
+    sentinel_pid = pids.get("sentinel")
+    running = is_running(sentinel_pid)
+    state_str = f"RUNNING (PID {sentinel_pid})" if running else "STOPPED"
+
+    print("\n================== KESSEL DAEMON STATUS ==================")
+    print(f"  Sentinel Daemon : {state_str}")
+
+    with sqlite3.connect(DB_PATH) as conn:
+        counts = conn.execute("SELECT status, count(*) FROM queue GROUP BY status;").fetchall()
+        rows = conn.execute(
+            "SELECT id, timestamp, sender, recipient, action, retries, status FROM queue ORDER BY id DESC LIMIT 6;"
+        ).fetchall()
+
+    print("\n================== QUEUE METRICS =========================")
+    if counts:
+        for status, count in counts:
+            print(f"  {status:<14}: {count}")
+    else:
+        print("  (Queue is empty)")
+
+    print("\n================= RECENT ACTIVITY ========================")
+    print(f"{'ID':<4} {'Timestamp':<20} {'Sender':<12} {'Recipient':<12} {'Retries':<8} {'Status':<10}")
+    print("-" * 72)
+    for r in rows:
+        print(f"{r[0]:<4} {r[1]:<20} {r[2]:<12} {r[3]:<12} {r[5]:<8} {r[6]:<10}")
+    print("=" * 72 + "\n")
+
+def cmd_audit(file_path):
+    if not os.path.exists(file_path):
+        print(f"[Error] Target file '{file_path}' does not exist.")
+        sys.exit(1)
+
+    class InlineVisitor(ast.NodeVisitor):
+        def __init__(self):
+            self.issues = []
+        def visit_Assign(self, node):
+            sensitive = {"api_key", "secret", "token", "password", "auth_key"}
+            for target in node.targets:
+                if isinstance(target, ast.Name) and target.id.lower() in sensitive:
+                    if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
+                        self.issues.append(f"Line {node.lineno}: Hardcoded credential in '{target.id}'. Move to os.getenv().")
+            self.generic_visit(node)
+
+    print(f"[Kessel Audit] Inspecting {file_path}...")
+    with open(file_path, "r") as f:
+        content = f.read()
+
+    try:
+        tree = ast.parse(content)
+        visitor = InlineVisitor()
+        visitor.visit(tree)
+    except SyntaxError as e:
+        print(f"[-] Syntax Error: {e}")
+        sys.exit(1)
+
+    if visitor.issues:
+        print(f"[-] FAILED: {len(visitor.issues)} security issue(s) detected:")
+        for issue in visitor.issues:
+            print(f"    -> {issue}")
+        sys.exit(1)
+
+    with open(file_path, "rb") as f:
+        sha256 = hashlib.sha256(f.read()).hexdigest()
+
+    manifest = {
+        "generated_at": datetime.utcnow().isoformat() + "Z",
+        "artifact": os.path.basename(file_path),
+        "sha256": sha256,
+        "status": "PASSED"
+    }
+    manifest_file = file_path + ".manifest.json"
+    with open(manifest_file, "w") as f:
+        json.dump(manifest, f, indent=2)
+
+    print(f"[+] PASSED: All static security gates verified.")
+    print(f"[+] Manifest: {manifest_file} (SHA256: {sha256[:12]}...)")
+    sys.exit(0)
+
+def cmd_clean():
+    init_env()
+    with sqlite3.connect(DB_PATH) as conn:
+        conn.execute("DELETE FROM queue WHERE status IN ('COMPLETED', 'DEAD_LETTER');")
+    print("[Kessel] Cleaned completed and dead-letter queue records.")
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: kessel {start|stop|restart|status|audit <file>|clean|init}")
+        sys.exit(1)
+
+    cmd = sys.argv[1].lower()
+    if cmd == "init":
+        init_env()
+        print("[Kessel] Initialized environment at ~/.kessel")
+    elif cmd == "start":
+        cmd_start()
+    elif cmd == "stop":
+        cmd_stop()
+    elif cmd == "restart":
+        cmd_stop()
+        time.sleep(0.5)
+        cmd_start()
+    elif cmd == "status":
+        cmd_status()
+    elif cmd == "audit":
+        if len(sys.argv) < 3:
+            print("Usage: kessel audit <path_to_file.py>")
+            sys.exit(1)
+        cmd_audit(sys.argv[2])
+    elif cmd == "clean":
+        cmd_clean()
+    else:
+        print(f"[Error] Unknown command: {cmd}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
